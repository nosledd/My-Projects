# Local Ollama endpoint and model. These are declared now for future adapters;
# this project skeleton does not connect to Ollama.
AUTOMATION_OLLAMA_BASE_URL=http://127.0.0.1:11434
AUTOMATION_OLLAMA_MODEL=gemma3:4b

# Runtime behavior
AUTOMATION_LOG_LEVEL=INFO
AUTOMATION_LOG_DIRECTORY=logs

# Hosting beta: temporary uploads/outputs are deleted after this period.
AUTOMATION_RETENTION_MINUTES=60

# Keep false for certificate-only hosting. Set true only when a reachable Ollama
# server is configured for generic document automation.
AUTOMATION_ENABLE_GEMMA=true
